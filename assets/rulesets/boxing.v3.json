{
  "schemaVersion": "3.0",
  "metrics": {
    "extensionRatio": {
      "unit": "ratio",
      "range": [
        0,
        1.2
      ],
      "noiseBand": 0.02,
      "baseline": 0.55,
      "cutoffHz": 8.0,
      "$doc": "|bilek-omuz| / kol uzunlugu — AYNI-KARE orani, kamera mesafesinden yapisi geregi bagimsiz.",
      "$cutoffWhy": "J-027: cekirdegin 1 Hz varsayilani 120 ms'lik yumrugun tepesini %22 sondurup PEAK'i hic atesnemiyordu. 8 Hz D2'den TURETILDI: bir gecisi korumak icin kesim ~1/(2T); medyan 128 ms -> 3.9 Hz, en hizli %10 54 ms -> 9.3 Hz."
    },
    "stanceWidthRatio": {
      "unit": "ratio",
      "range": [
        0,
        4.0
      ],
      "noiseBand": 0.05,
      "baseline": 1.4,
      "$doc": "Ayak acikligi / omuz genisligi. baseline 1.40 = dengeli boks durusu."
    },
    "guardHeightDelta": {
      "unit": "ratio",
      "range": [
        -1.5,
        1.5
      ],
      "noiseBand": 0.03,
      "baseline": -0.1,
      "$doc": "(bilek.y - burun.y) / govde boyu. Negatif = el burnun ustunde (gard yukarida)."
    },
    "elbowFlareAngle": {
      "unit": "deg",
      "range": [
        0,
        180
      ],
      "noiseBand": 4.0,
      "baseline": 20.0,
      "cutoffHz": 8.0,
      "$doc": "Ust kolun govde eksenine gore sapmasi. Dirsek yapisikken kucuk, disa acildikca 90'a yaklasir.",
      "$cutoffWhy": "Hizli-gecisli metrik: yumruk kolu tepe hizinda."
    },
    "trunkLeanAngle": {
      "unit": "deg",
      "range": [
        0,
        90
      ],
      "noiseBand": 3.0,
      "baseline": 8.0,
      "$doc": "Govde ekseninin dikeyden sapmasi."
    },
    "shoulderRotation": {
      "unit": "deg",
      "range": [
        0,
        90
      ],
      "noiseBand": 4.0,
      "baseline": 10.0,
      "cutoffHz": 8.0,
      "$doc": "Omuz cizgisi ile kalca cizgisi arasindaki aci — govde rotasyonu VEKILI. 2B izdusum: gercek transvers rotasyonun ALT SINIRI.",
      "$cutoffWhy": "Hizli-gecisli metrik: cross rotasyonu uzanmadan once tamamlaniyor."
    },
    "copOverBase": {
      "unit": "ratio",
      "range": [
        0,
        2.0
      ],
      "noiseBand": 0.04,
      "baseline": 0.0,
      "$doc": "Kalca orta noktasinin ayak taban poligonundan tasma miktari."
    },
    "frontFootLoadRatio": {
      "unit": "ratio",
      "range": [
        0,
        1.0
      ],
      "noiseBand": 0.05,
      "baseline": 0.5,
      "$doc": "On/arka ayak yuk dagilimi VEKILI — kuvvet olcumu DEGIL. Brans farkinin tek eksik olcusuydu (kickboks on-hasadi)."
    }
  },
  "techniques": [
    {
      "id": "jab",
      "limb": "lead_arm",
      "sideResolution": "visible",
      "phases": [
        {
          "id": "GUARD_READY",
          "enter": {
            "kind": "metric",
            "metric": "extensionRatio",
            "op": "lt",
            "value": 0.62
          },
          "timeoutMs": 4000,
          "requiredLandmarks": [
            "lead_wrist",
            "lead_elbow",
            "lead_shoulder",
            "rear_wrist"
          ]
        },
        {
          "id": "EXTENSION",
          "enter": {
            "kind": "all",
            "of": [
              {
                "kind": "metric",
                "metric": "extensionRatio",
                "op": "gt",
                "value": 0.68
              },
              {
                "kind": "delta",
                "metric": "extensionRatio",
                "op": "gt",
                "valuePerSecond": 0
              }
            ]
          },
          "timeoutMs": 400,
          "$doc": "J-009: timeout'suz 'uzatip bekleme' yumruk sayiliyordu — D2 olcumunde torbaya yaslanan boksor 736 ms'lik sahte yumruk uretti."
        },
        {
          "id": "PEAK",
          "enter": {
            "kind": "all",
            "of": [
              {
                "kind": "metric",
                "metric": "extensionRatio",
                "op": "gt",
                "value": 0.85
              },
              {
                "kind": "localMax",
                "metric": "extensionRatio"
              }
            ]
          },
          "timeoutMs": 150,
          "quality": {
            "elbowFlareAngle": 45.0
          },
          "$doc": "D2 ayrimi: enter = 'bu faza girdim mi' (sayim sorusu), quality = 'iyi yaptim mi' (hukum sorusu). Ikisi ayri yazilir."
        },
        {
          "id": "RETRACTION",
          "enter": {
            "kind": "all",
            "of": [
              {
                "kind": "metric",
                "metric": "extensionRatio",
                "op": "lt",
                "value": 0.8
              },
              {
                "kind": "delta",
                "metric": "extensionRatio",
                "op": "lt",
                "valuePerSecond": 0
              }
            ]
          },
          "timeoutMs": 600
        },
        {
          "id": "GUARD_RECOVERED",
          "enter": {
            "kind": "metric",
            "metric": "extensionRatio",
            "op": "lt",
            "value": 0.62
          },
          "terminal": true
        }
      ],
