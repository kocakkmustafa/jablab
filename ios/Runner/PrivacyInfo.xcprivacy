<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- İZLEME: yok. Ürün ağ isteği YAPMIYOR; ham video cihazda kalıyor ve
       yalnız ölçülen vücut noktaları işleniyor (Info.plist'teki kamera
       gerekçesiyle aynı cümle). -->
  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyTrackingDomains</key>
  <array/>

  <!-- TOPLANAN VERİ: yok. Seans kaydı YALNIZ cihazda, uygulama destek
       dizininde; hiçbir yere gönderilmiyor. -->
  <key>NSPrivacyCollectedDataTypes</key>
  <array/>

  <!-- GEREKÇELİ API'LER.
       Ölçüldü: app kodu dosya YAZIP OKUYOR (`onboarding_seen`, seans
       geçmişi) ama zaman damgası okumuyor; `permission_handler_apple`
       KENDİ manifestini taşıyor, `path_provider_foundation` taşımıyor
       ama dizin çözümlemesi (`URLsForDirectory:`) gerekçeli API listesinde
       değil. Bu yüzden liste BOŞ bırakıldı. -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array/>
</dict>
</plist>
