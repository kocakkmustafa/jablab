# KAMERA KÖPRÜSÜ (J-071): `motion_camera` podspec'i `s.platform = :ios,
# '14.0'` beyan ediyor (MediaPipeTasksVision 0.10.21 pini gereği). Platform
# satırı yorumdayken pod install eklentinin tabanını çözemez.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # KAMERA KÖPRÜSÜ (J-071): MediaPipeTasksVision 0.10.21 STATİK bir
  # xcframework dağıtıyor. Çıplak `use_frameworks!` (dinamik) ile CocoaPods
  # bunu reddediyor:
  #   "[!] The 'Pods-Runner' target has transitive dependencies that include
  #    statically linked binaries: .../MediaPipeTasksVision.xcframework"
  # Statik linkleme MediaPipe pinini VERİLDİĞİ GİBİ tüketmenin yolu — pin
  # M-L-02 gereği sabit, o yüzden çözüm bizim tarafta.
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # permission_handler_apple compiles camera support only with this macro.
      # Keep any definitions supplied by Flutter or another pod.
      existing = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS']
      definitions = existing.nil? ? ['$(inherited)'] : Array(existing).dup
      definitions << 'PERMISSION_CAMERA=1' unless definitions.include?('PERMISSION_CAMERA=1')
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = definitions
    end
  end

  # RunnerTests is hosted by Runner. MediaPipeTasksCommon's user_target_xcconfig
  # force-loads its graph library into every user target, including the test
  # bundle (inherit! :search_paths does not stop it). Loading the graph in both
  # binaries registers its calculators twice and XCTest aborts at launch
  # (FunctionRegistry::Register -> SIGABRT). Same fix as ostinato e203dc6.
  test_pods_targets = installer.aggregate_targets.select { |target| target.name == 'Pods-RunnerTests' }
  raise 'Expected exactly one Pods-RunnerTests target' unless test_pods_targets.length == 1

  test_pods = test_pods_targets.fetch(0)
  expected_test_graph_flags = {
    'OTHER_LDFLAGS[sdk=iphoneos*]' => '$(inherited) -force_load "$(PODS_ROOT)/MediaPipeTasksCommon/frameworks/graph_libraries/libMediaPipeTasksCommon_device_graph.a"',
    'OTHER_LDFLAGS[sdk=iphonesimulator*]' => '$(inherited) -force_load "${PODS_ROOT}/MediaPipeTasksCommon/frameworks/graph_libraries/libMediaPipeTasksCommon_simulator_graph.a"',
  }
  test_configs = test_pods.xcconfigs
  raise 'Unexpected RunnerTests configurations' unless test_configs.keys.sort == %w[Debug Profile Release]

  test_configs.each do |name, config|
    expected_test_graph_flags.each do |key, value|
      raise "Unexpected RunnerTests #{name} #{key}" unless config.attributes[key] == value
      config.attributes.delete(key)
    end
    config.save_as(test_pods.xcconfig_path(name))
  end
end
