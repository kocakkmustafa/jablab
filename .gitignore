.dart_tool/
.packages
build/
# iCloud CATISMA KOPYASI. Bu proje ~/Documents altinda ve orasi iCloud'a
# senkronlaniyor; codesign panzehiri `build`i bir symlink yapinca iCloud onun
# kopyasini uretti ("build 3" -> ayni hedef, 0 bayt). Zararsiz ama `build/`
# deseni bosluklu adi kapsamadigi icin `git status`ta kalici gurultu yapardi.
build [0-9]*
*.iml
.DS_Store

# Flutter'in urettigi eklenti onbellegi — makineye ozel yollar iceriyor,
# her `pub get`te degisiyor. Izlemek her makinede sahte diff uretir.
.flutter-plugins-dependencies

# PİNLİ poz modeli ikilisi (9,4 MB) — aile kuralıyla hizalı
# (motion-core/.gitignore da `.task` izlemiyor). Pin URL + SHA olarak yaşar:
# `tool/fetch_pose_model.sh` + `test/model_pin_test.dart`. `latest` YASAK
# (M-L-01: full varyantında latest≠1, aynı boyut farklı hash).
assets/models/*.task
